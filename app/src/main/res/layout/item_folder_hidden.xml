<?xml version="1.0" encoding="utf-8"?>
<!-- Carpeta oculta: tocar la fila abre sus canciones; «Mostrar» la devuelve al inicio. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/space_s"
    android:paddingStart="@dimen/space_l"
    android:paddingEnd="@dimen/space_m">

    <FrameLayout
        android:layout_width="@dimen/size_artwork_m"
        android:layout_height="@dimen/size_artwork_m"
        android:background="@drawable/bg_rounded_m"
        android:backgroundTint="?attr/colorSurfaceContainerHighest">

        <ImageView
            android:layout_width="@dimen/size_icon"
            android:layout_height="@dimen/size_icon"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_folder_off"
            app:tint="?attr/colorOnSurfaceVariant" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_l"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.KitMux.ListTitle"
            tools:text="Rock" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.KitMux.ListSubtitle"
            tools:text="12 canciones · Music" />
    </LinearLayout>

    <Button
        android:id="@+id/unhide"
        style="@style/Widget.Material3.Button.TonalButton.Icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/unhide"
        app:icon="@drawable/ic_visibility" />
</LinearLayout>
